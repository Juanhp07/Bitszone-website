---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Acceder - Bitszone">
  <div class="w-full h-screen bg-[#050505] text-white font-inter overflow-hidden flex flex-col relative items-center justify-center">
    {/* Unified Global Background (matches player) */}
    <div class="absolute inset-0 bg-gradient-to-br from-purple-900/20 via-[#050505] to-blue-900/20 pointer-events-none z-0"></div>
    <div class="absolute top-0 left-0 right-0 h-[600px] bg-gradient-to-b from-[#a855f7]/15 to-transparent pointer-events-none z-0 transition-opacity duration-700"></div>

    <div class="relative z-10 w-full max-w-md p-8 bg-[#111111]/80 backdrop-blur-xl border border-white/5 rounded-2xl shadow-2xl">
      <div class="text-center mb-8">
        <h1 class="text-4xl mb-2 font-italic font-serif italic" style="font-family: 'DM Serif Display', serif;">Bitszone</h1>
        <p class="text-white/50 text-sm">Inicia sesión en tu cuenta</p>
      </div>

      <form class="flex flex-col gap-5">
        <div class="flex flex-col gap-2">
          <label for="email" class="text-sm font-medium text-white/70">Correo Electrónico</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            placeholder="tu@email.com" 
            class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white placeholder-white/30 focus:outline-none focus:border-[#a855f7] focus:ring-1 focus:ring-[#a855f7] transition-all"
            required
          />
        </div>

        <div class="flex flex-col gap-2">
          <label for="password" class="text-sm font-medium text-white/70">Contraseña</label>
          <input 
            type="password" 
            id="password" 
            name="password" 
            placeholder="••••••••" 
            class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white placeholder-white/30 focus:outline-none focus:border-[#a855f7] focus:ring-1 focus:ring-[#a855f7] transition-all"
            required
          />
        </div>

        <button 
          type="button" 
          class="w-full mt-2 bg-[#a855f7] hover:bg-[#a855f7]/80 text-white font-medium py-3 px-4 rounded-lg transition-colors duration-200"
        >
          Iniciar Sesión
        </button>

        <div class="text-center mt-4">
          <a href="#" class="text-sm text-white/50 hover:text-white transition-colors">¿Olvidaste tu contraseña?</a>
        </div>
      </form>
    </div>
  </div>
</Layout>
