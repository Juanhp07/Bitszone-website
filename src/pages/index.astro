---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/Header';
import { HeroSection } from '../components/HeroSection';
import { FeatureSection } from '../components/FeatureSection';
import { ProblemSection } from '../components/ProblemSection';
import { FAQSection } from '../components/FAQSection';
import { SmoothScroll } from '../components/ui/SmoothScroll';
import MoltenMetal from '../components/ui/MoltenMetal';
import HeroBackgroundFade from '../components/ui/HeroBackgroundFade';
import { CinematicFooter } from '../components/ui/motion-footer';
---

<Layout title="Bitszone - Tu música sin conexión" scrollable>
  <SmoothScroll client:load>
    
    {/* Global Molten Metal Background */}
    <div class="fixed inset-0 z-[-2] overflow-hidden pointer-events-none">
      <MoltenMetal
        client:load
        color1="#5227FF"
        color2="#FF9FFC"
        color3="#B497CF"
        speed={0.2}
        scale={2.5}
        detail={4}
        glow={0.5}
        coreSize={0.15}
        swirl={1.2}
        fold={-0.3}
        blackPoint={0.5}
        brightness={0.6}
        colorMode="molten"
        grain={true}
        grainIntensity={0.03}
        opacity={0.8}
        backgroundColor="#05050A"
        lightMode={false}
      />
    </div>

    {/* Hero LiquidEther Curtain (Fades out fully on scroll) */}
    <HeroBackgroundFade client:load />
    
    <Header client:load />
    
    <main class="relative z-10">
      <HeroSection client:load />
      <FeatureSection client:only="react" />
      <ProblemSection client:visible />
      <FAQSection client:visible />
    </main>

    <CinematicFooter client:load />
  </SmoothScroll>
</Layout>
