---
import Layout from '../layouts/Layout.astro';
import { UserCog } from 'lucide-react';
---

<Layout title="Administración | BitsZone">
  <main class="min-h-screen bg-[#0d0d12] text-white flex flex-col items-center justify-center p-8 relative overflow-hidden">
    
    {/* Background Subtle Elements */}
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0 pointer-events-none">
      <div class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-purple-600/20 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-blue-600/20 rounded-full blur-[120px]"></div>
    </div>

    <div class="z-10 max-w-2xl w-full bg-[rgba(20,20,25,0.7)] border border-white/10 rounded-3xl p-12 backdrop-blur-[20px] shadow-2xl flex flex-col items-center text-center">
      
      <div class="w-20 h-20 rounded-full flex items-center justify-center bg-gradient-to-tr from-blue-600 to-purple-600 mb-6 shadow-lg shadow-purple-500/20">
        <UserCog className="w-10 h-10 text-white" />
      </div>

      <h1 class="text-4xl font-bold mb-4">Panel de Administración</h1>
      
      <p class="text-gray-400 mb-10 text-lg">
        Bienvenido al centro de control de BitsZone. Esta sección está en construcción. Próximamente podrás gestionar usuarios, licencias y contenido musical desde aquí.
      </p>
      
      <a 
        href="/login" 
        class="px-8 py-3 bg-white text-black font-semibold rounded-xl hover:bg-gray-200 transition-colors shadow-lg"
      >
        Volver al Login
      </a>
    </div>
  </main>
</Layout>
